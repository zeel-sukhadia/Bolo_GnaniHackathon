# Copy to .env (never commit .env). All secrets stay on the backend.

# --- Gnani hosted speech APIs (Prisma v2.5 STT, Timbre v2.5 TTS)
# Get a key from the Gnani dashboard; sent as the X-API-Key-ID header.
GNANI_API_KEY=replace-with-your-gnani-key
GNANI_BASE_URL=https://api.vachana.ai

# --- Evon v3.3 (open weights, self-hosted on a GPU). See deploy/EVON_REMOTE_GPU.md.
# remote    = call the Evon OpenAI-compatible server below
# anthropic = Claude stands in for Evon (labelled in the UI) until an Evon GPU server is available
# mock      = labelled simulated output, no model (offline dev)
EVON_MODE=remote
# The server's public HTTPS URL ending in /v1. Never localhost for a Colab/remote GPU.
EVON_BASE_URL=https://your-tunnel-name.trycloudflare.com/v1
# Must match the server's --served-model-name. (EVON_MODEL is accepted as an older alias.)
EVON_MODEL_NAME=model
# The same value the server was started with (--api-key). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
EVON_API_KEY=replace-with-a-long-random-key
# Sends chat_template_kwargs.enable_thinking=false (vLLM/SGLang). Set false if your server rejects it.
EVON_DISABLE_THINKING=true
# Seconds per request. Keep under 100 behind a Cloudflare quick tunnel (it cuts requests at 100 s).
EVON_TIMEOUT=90

# --- Claude stand-in for Evon (EVON_MODE=anthropic). Key from console.anthropic.com; server-side only.
ANTHROPIC_API_KEY=replace-with-your-anthropic-key
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_TIMEOUT=60

# --- Database (SQLite for local dev; PostgreSQL in production)
DATABASE_URL=sqlite:///./agent.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agent

# --- Sessions: set COOKIE_SECURE=true when served over HTTPS
COOKIE_SECURE=false
SESSION_DAYS=14

# --- Policy
RETENTION_DAYS=30
MAX_CALL_ATTEMPTS=3
REDIAL_BACKOFF_SECONDS=120,600

# --- Web Push. Generate: cd backend && .venv/Scripts/python -m app.worker --gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
